rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Identify the Root Administrator by verified email
    function isRoot() {
      return request.auth != null && 
             request.auth.token.email.lower() == 'nexovtech@myyahoo.com';
    }

    // Helper: Check if the user is an authorized employee
    // Note: We allow read if authenticated to prevent listing failures
    function isAuth() {
      return request.auth != null;
    }

    // Rules for the personnel registry (employees)
    match /employees/{docId} {
      // Allow any authenticated staff to read the registry
      allow read: if isAuth();
      // Only root admin or system service can modify records
      allow write: if isRoot();
    }

    // Rules for the digital identity system (idcards)
    match /idcards/{cardId} {
      allow read: if isAuth();
      allow write: if isRoot();
    }

    // Audit Trail: Allow creation of logs for security monitoring
    match /admin_logs/{logId} {
      // Anyone can create a log (needed for tracking auth failures)
      allow create: if true;
      // Only root admin can read or manage the logs
      allow read, update, delete: if isRoot();
    }

    // Global rule for security-critical infrastructure
    match /{document=**} {
      // Root admin has total sovereignty
      allow read, write: if isRoot();
      // Authenticated users can read relevant operational data
      allow read: if isAuth();
    }
  }
}
