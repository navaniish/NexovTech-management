rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to identify the Root Administrator
    function isRoot() {
      return request.auth != null && 
             'email' in request.auth.token && 
             request.auth.token.email.lower() == 'nexovtech@myyahoo.com';
    }

    // Helper to check if a user is an active employee
    function isActive() {
      return request.auth != null && 
             'email' in request.auth.token &&
             get(/databases/$(database)/documents/employees/$(request.auth.token.email.lower())).data.status == 'active';
    }

    // Rules for the employees collection
    match /employees/{email} {
      // Allow read if authenticated or if it's the root admin's own record
      allow read: if request.auth != null || email == 'nexovtech@myyahoo.com';
      // Only root admin or authorized admins can write
      allow write: if isRoot();
    }

    // Global rule for all other collections
    match /{document=**} {
      // Root admin has full access; other active employees can read/write their relevant data
      allow read, write: if isRoot() || isActive();
    }
  }
}
