{
  "version": 2,
  "framework": "vite",
  "buildCommand": "cd client && npm install --include=dev && npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "excludeFiles": "{client/**,docs/**,netlify/**,.netlify/**,nexovtech.apk,brain/**,node_modules/prisma/**,node_modules/@prisma/engines/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
