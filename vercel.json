{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "/assets/(.*)",
      "dest": "client/dist/assets/$1"
    },
    {
      "src": "/verify/(.*)",
      "dest": "client/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/$1",
      "check": true
    },
    {
      "src": "/(.*)",
      "dest": "client/dist/index.html"
    }
  ]
}
