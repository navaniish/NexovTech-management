{
  "name": "nexovtech-management",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "client": "cd client && npm run dev",
    "server": "cd server && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run generate && cd client && npm ci && npm run build",
    "generate": "prisma generate --schema=server/prisma/schema.prisma || (cd server && npx prisma generate)",
    "deploy": "vercel --prod"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.4.1",
    "vite": "^8.0.9"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.5.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.0",
    "nodemon": "^3.1.14",
    "openai": "^6.37.0",
    "otplib": "^13.4.0",
    "pdfkit": "^0.18.0",
    "qrcode": "^1.5.4",
    "request-ip": "^3.3.0",
    "serverless-http": "^4.0.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "telegraf": "^4.16.3",
    "useragent": "^2.3.0"
  }
}